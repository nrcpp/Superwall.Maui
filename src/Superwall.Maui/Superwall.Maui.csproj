<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-ios;net10.0-android</TargetFrameworks>
    <RootNamespace>Superwall.Maui</RootNamespace>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>

    <PackageId>Superwall.Maui</PackageId>
    <Title>Superwall.Maui</Title>
    <Version>1.0.0-preview.3</Version>
    <Authors>Denys Kazakov</Authors>
    <Description>Unofficial .NET MAUI bridge to the official Superwall SDKs (SuperwallKit $(SuperwallIosVersion), superwall-android $(SuperwallAndroidVersion)) for iOS and Android: remote paywalls, purchases and restore, subscription status, user identity and attributes, paywall delegate events and deep links. Not affiliated with Superwall.</Description>
    <Copyright>Copyright (c) 2026 Denys Kazakov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>superwall;paywall;paywalls;maui;dotnet-maui;ios;android;subscriptions;in-app-purchase;monetization;superwallkit</PackageTags>
    <PackageProjectUrl>https://github.com/nrcpp/Superwall.Maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nrcpp/Superwall.Maui.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>Updates the iOS bridge to SuperwallKit $(SuperwallIosVersion); Android remains on superwall-android $(SuperwallAndroidVersion). No public API changes. Full list: https://github.com/nrcpp/Superwall.Maui/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" Visible="false" />
    <None Include="../../assets/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Superwall.Maui.Tests" />
  </ItemGroup>

  <!-- Platform-specific sources: each Platforms/<X> folder compiles only for its TFM. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
    <Compile Remove="Platforms/iOS/**" />
    <None Include="Platforms/iOS/**" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'android'">
    <Compile Remove="Platforms/Android/**" />
    <None Include="Platforms/Android/**" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != ''">
    <Compile Remove="Platforms/NetStandard/**" />
    <None Include="Platforms/NetStandard/**" />
  </ItemGroup>

  <!-- iOS: this TFM is also an ObjC binding of the Swift wrapper in native/ios (built by xcodebuild on macOS). -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <IsBindingProject>true</IsBindingProject>
  </PropertyGroup>
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <Compile Remove="Platforms/iOS/ApiDefinition.cs" />
    <ObjcBindingApiDefinition Include="Platforms/iOS/ApiDefinition.cs" />
    <XcodeProject Include="../../native/ios/SuperwallMauiBridge.xcodeproj" SchemeName="SuperwallMauiBridge" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Core" Version="$(MauiPackageVersion)" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidGradleProject Include="../../native/android/build.gradle.kts" ModuleName="superwallmauibridge" />
    <AndroidMavenLibrary Include="com.superwall.sdk:superwall-android" Version="$(SuperwallAndroidVersion)" Bind="false" />
    <AndroidMavenLibrary Include="com.superwall.supercel:supercel" Version="1.0.13" Bind="false" />
    <AndroidMavenLibrary Include="net.java.dev.jna:jna" Version="5.17.0" ArtifactFilename="jna-5.17.0.aar" Bind="false" />
    <AndroidMavenLibrary Include="org.threeten:threetenbp" Version="1.6.8" Bind="false" />
    <AndroidMavenLibrary Include="com.android.billingclient:billing" Version="9.1.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="org.jetbrains.kotlinx:kotlinx-serialization-json" Version="1.7.2" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.play:review" Version="2.0.2" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.gms:play-services-base" Version="18.5.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.gms:play-services-basement" Version="18.9.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.gms:play-services-tasks" Version="18.2.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.gms:play-services-location" Version="19.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.gms:play-services-places-placereport" Version="17.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.play:core-common" Version="2.0.4" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.datatransport:transport-api" Version="3.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.datatransport:transport-backend-cct" Version="3.1.8" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.android.datatransport:transport-runtime" Version="3.1.8" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.firebase:firebase-encoders" Version="17.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.firebase:firebase-encoders-proto" Version="16.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="com.google.firebase:firebase-encoders-json" Version="18.0.0" Repository="Google" Bind="false" />
    <AndroidMavenLibrary Include="org.jetbrains.kotlinx:kotlinx-serialization-json-jvm" Version="1.7.2" Bind="false" />
    <AndroidMavenLibrary Include="javax.inject:javax.inject" Version="1" Bind="false" />
    <PackageReference Include="Xamarin.Kotlin.StdLib" Version="$(KotlinPackageVersion)" />
    <PackageReference Include="Xamarin.Kotlin.StdLib.Jdk8" Version="$(KotlinJdk8PackageVersion)" />
    <PackageReference Include="Xamarin.Kotlin.StdLib.Common" Version="$(KotlinCommonPackageVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Core" Version="$(CoroutinesPackageVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Android" Version="$(CoroutinesPackageVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Coroutines.Guava" Version="$(CoroutinesPackageVersion)" />
    <PackageReference Include="Xamarin.KotlinX.Serialization.Core.Jvm" Version="$(SerializationCoreJvmPackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="$(WorkRuntimePackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Work.Work.Runtime.Ktx" Version="$(WorkRuntimePackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="$(LifecyclePackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="$(LifecyclePackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Service" Version="$(LifecycleServicePackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Room.Runtime" Version="$(RoomPackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Room.Room.Ktx" Version="$(RoomPackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Activity" Version="$(ActivityPackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Ktx" Version="$(ActivityPackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Browser" Version="$(BrowserPackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core" Version="$(AndroidCorePackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.Core.Core.Ktx" Version="$(AndroidCorePackageVersion)" />
    <PackageReference Include="Xamarin.AndroidX.AppCompat" Version="$(AppCompatPackageVersion)" />
    <PackageReference Include="Xamarin.Google.Android.Material" Version="$(MaterialPackageVersion)" />
    <PackageReference Include="Xamarin.Google.Android.InstallReferrer" Version="$(InstallReferrerPackageVersion)" />
  </ItemGroup>

  <!-- These Google POMs specify AndroidX baselines already supplied by MAUI at newer compatible versions. -->
  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
    <AndroidIgnoredJavaDependency Include="androidx.collection:collection:1.0.0" />
    <AndroidIgnoredJavaDependency Include="androidx.fragment:fragment:1.1.0" />
    <AndroidIgnoredJavaDependency Include="androidx.annotation:annotation:1.3.0" />
  </ItemGroup>

</Project>
