<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Superwall.Maui.Sample.MainPage"
             Title="Superwall Sample">

    <Grid Padding="20" RowSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
        <Label x:Name="StatusLabel" Grid.Row="0" FontSize="14" />

        <Entry x:Name="PlacementEntry" Grid.Row="1" Placeholder="Placement" Text="onboarding_complete"
               AutomationId="PlacementEntry" />

        <HorizontalStackLayout Grid.Row="2" Spacing="12">
            <Button x:Name="ShowButton" Text="Show Paywall" Clicked="OnShowClicked" AutomationId="ShowPaywall" />
            <Button x:Name="DismissButton" Text="Dismiss" Clicked="OnDismissClicked" AutomationId="Dismiss" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="3" Spacing="8">
            <CheckBox x:Name="AutoDismissCheckBox" AutomationId="AutoDismiss" VerticalOptions="Center" />
            <Label Text="Dismiss from code 5 s after present" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="4" Spacing="12">
            <Button Text="Check Status" Clicked="OnStatusClicked" AutomationId="CheckStatus" />
            <Button Text="Restore Purchases" Clicked="OnRestoreClicked" AutomationId="RestorePurchases" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="5" Spacing="12">
            <Button Text="Presentation Result" Clicked="OnPresentationResultClicked" AutomationId="PresentationResult" />
            <Button Text="Preload" Clicked="OnPreloadClicked" AutomationId="Preload" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="6" Spacing="12">
            <Entry x:Name="UserIdEntry" Placeholder="User ID" Text="sample-user-1" WidthRequest="140" AutomationId="UserIdEntry" />
            <Button Text="Identify" Clicked="OnIdentifyClicked" AutomationId="Identify" />
            <Button Text="Reset" Clicked="OnResetClicked" AutomationId="Reset" />
        </HorizontalStackLayout>

        <HorizontalStackLayout Grid.Row="7" Spacing="12">
            <Button Text="Set Attributes" Clicked="OnSetAttributesClicked" AutomationId="SetAttributes" />
            <Button Text="Get Attributes" Clicked="OnGetAttributesClicked" AutomationId="GetAttributes" />
        </HorizontalStackLayout>

        <Grid Grid.Row="8" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="ProductIdsEntry" Grid.Column="0" Placeholder="IAP IDs, comma separated" AutomationId="ProductIdsEntry" />
            <Button Grid.Column="1" Text="Get Products" Clicked="OnGetProductsClicked" AutomationId="GetProducts" />
        </Grid>

        <Grid Grid.Row="9" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Picker x:Name="ProductsPicker" Grid.Column="0" Title="Select product" ItemDisplayBinding="{Binding ProductId}"
                    SelectedIndexChanged="OnProductSelectionChanged" AutomationId="ProductsPicker" />
            <Button Grid.Column="1" Text="Purchase" Clicked="OnPurchaseClicked" AutomationId="DirectPurchase" />
        </Grid>

        <Label x:Name="ProductDetailsLabel" Grid.Row="10" FontSize="12"
               Text="Credits are not granted or consumed by this sample. Verify purchases on your backend first." />

        <Label Grid.Row="11" Text="Log" FontAttributes="Bold" />

        <CollectionView x:Name="LogView" Grid.Row="12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <Label Text="{Binding .}" FontSize="12" Padding="0,2" />
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>

</ContentPage>
