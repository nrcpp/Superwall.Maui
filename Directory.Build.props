<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Native SDK versions: keep in sync with native/ios/project.yml and native/android/gradle/libs.versions.toml -->
    <SuperwallIosVersion>4.19.1</SuperwallIosVersion>
    <SuperwallAndroidVersion>2.9.0</SuperwallAndroidVersion>

    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
